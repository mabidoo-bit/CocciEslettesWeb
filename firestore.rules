rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Chaque client ne peut lire/modifier que son propre document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Vérification des droits admin (lecture de son propre statut uniquement)
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Catalogue : tout le monde peut lire, seuls les admins peuvent modifier
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Rayons : tout le monde peut lire, seuls les admins peuvent modifier
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Commandes : n'importe qui peut créer une commande, seuls les admins peuvent les lire
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

  }
}
